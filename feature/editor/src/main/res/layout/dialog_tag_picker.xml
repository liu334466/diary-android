<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/dsColorBg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/ds_grabber" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="标签"
        android:textColor="?attr/dsColorInk"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tagHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:textColor="?attr/dsColorMuted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/ds_bg_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/tagInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="新建标签"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="10"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="?attr/dsColorInk"
            android:textColorHint="?attr/dsColorLineStrong"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/createButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/ds_bg_ink"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="新建"
            android:textColor="?attr/dsColorBg"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:text="还没有标签，先在输入框里新建一个。"
        android:textColor="?attr/dsColorMuted"
        android:textSize="12sp"
        android:visibility="gone" />

    <GridLayout
        android:id="@+id/tagGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/doneButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="完成"
        android:textColor="?attr/dsColorBg"
        android:textSize="15sp"
        app:backgroundTint="?attr/dsColorInk"
        app:cornerRadius="8dp" />
</LinearLayout>
