<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsColorBg">

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ds_bg_ripple"
                android:contentDescription="返回"
                android:padding="9dp"
                android:src="@drawable/ic_ds_back" />

            <LinearLayout
                android:id="@+id/categoryPill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ds_bg_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/categoryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="100dp"
                    android:maxLines="1"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_ds_chevron_down" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/saveState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="已保存"
                android:textColor="?attr/dsColorMuted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/doneButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="完成"
                android:textColor="?attr/dsColorInk"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/editorScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="4dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/metaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="18dp"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/titleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="标题"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="?attr/dsColorInk"
                    android:textColorHint="?attr/dsColorLineStrong"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/tagScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tagRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <com.diary.feature.editor.RichEditText
                    android:id="@+id/bodyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="开始写点什么…"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:lineSpacingMultiplier="1.7"
                    android:minHeight="300dp"
                    android:padding="0dp"
                    android:textColor="?attr/dsColorInk"
                    android:textColorHint="?attr/dsColorLineStrong"
                    android:textSize="17sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/dsColorLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="?attr/dsColorBg"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/toolImage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_ds_image"
                    app:tint="?attr/dsColorInk2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="图片"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolAlign"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_ds_align"
                    app:tint="?attr/dsColorInk2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="对齐"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_ds_list"
                    app:tint="?attr/dsColorInk2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="列表"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolFont"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_ds_type"
                    app:tint="?attr/dsColorInk2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="字体"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolSize"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_ds_sliders"
                    app:tint="?attr/dsColorInk2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="字号"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolMore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_ds_more"
                    app:tint="?attr/dsColorInk2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="更多"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/ds_bg_ink"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selFont"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="字体"
            android:textColor="?attr/dsColorBg"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/selSize"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="字号"
            android:textColor="?attr/dsColorBg"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/dsColorLineStrong" />

        <TextView
            android:id="@+id/selBold"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="B"
            android:textColor="?attr/dsColorBg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selItalic"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="I"
            android:textColor="?attr/dsColorBg"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/selUnderline"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="U"
            android:textColor="?attr/dsColorBg"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/selColor"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="颜色"
            android:textColor="?attr/dsColorBg"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
