<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsColorBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ds_bg_ripple"
            android:contentDescription="返回"
            android:padding="9dp"
            android:src="@drawable/ic_ds_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/editButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/ds_bg_ripple"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="编辑"
            android:textColor="?attr/dsColorInk"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fontButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ds_bg_ripple"
            android:gravity="center"
            android:text="Aa"
            android:textColor="?attr/dsColorInk"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shareButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ds_bg_ripple"
            android:contentDescription="导出分享"
            android:padding="10dp"
            android:src="@drawable/ic_ds_share" />

        <ImageView
            android:id="@+id/moreButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ds_bg_ripple"
            android:contentDescription="更多"
            android:padding="10dp"
            android:src="@drawable/ic_ds_more" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/readerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/metaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/dsColorMuted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:lineSpacingExtra="6dp"
                android:textColor="?attr/dsColorInk"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/dsColorMuted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingMultiplier="1.9"
                android:textColor="?attr/dsColorInk"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
