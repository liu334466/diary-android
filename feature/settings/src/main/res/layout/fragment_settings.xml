<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsColorBg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.08"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:text="设置"
        android:textColor="?attr/dsColorInk"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="外观"
                android:textColor="?attr/dsColorMuted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/appearanceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="模式"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/appearanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="?attr/dsColorLine" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="默认样式"
                android:textColor="?attr/dsColorMuted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/defaultFontRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="默认字体"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/defaultFontValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/defaultSizeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="默认字号"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/defaultSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="?attr/dsColorLine" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="内容管理"
                android:textColor="?attr/dsColorMuted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/fontManageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="字体管理"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/fontManageValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/trashRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="回收站"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/trashValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tagManageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="标签管理"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="重命名 / 删除"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/backupRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="备份与恢复"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/backupValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="本地 ZIP"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="?attr/dsColorLine" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="关于"
                android:textColor="?attr/dsColorMuted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="版本"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/versionValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/privacyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="隐私政策"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/crashLogRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_ripple"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="诊断日志"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/crashLogValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ds_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ds_bg_soft"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="数据说明"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="所有日记、分类与字体文件都保存在本机，不会上传到任何服务器。卸载应用或清除应用数据会一并删除，且无法找回。"
                    android:textColor="?attr/dsColorInk2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
