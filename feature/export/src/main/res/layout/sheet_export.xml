<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/dsColorBg"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/ds_grabber" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="导出这篇日记"
        android:textColor="?attr/dsColorInk"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="按当前排版渲染，自定义字体会一并嵌入"
        android:textColor="?attr/dsColorMuted"
        android:textSize="12sp" />

    <!-- 选择格式 -->
    <LinearLayout
        android:id="@+id/chooseGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/optionPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ds_bg_cell"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/pdfIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="PDF"
                android:src="@drawable/ic_ds_file_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pdfTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF 文档"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pdfDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="A4 自动分页，保留字体、字号、对齐与图片，文字可复制"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/pdfCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="?attr/dsColorMuted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionPng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ds_bg_cell"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/pngIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="PNG"
                android:src="@drawable/ic_ds_image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pngTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNG 长图"
                    android:textColor="?attr/dsColorInk"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pngDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="宽度固定、按内容纵向拼接，适合直接分享"
                    android:textColor="?attr/dsColorMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/pngCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="?attr/dsColorMuted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/exportNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="导出会使用当前这一篇的字体与字号；超过 2 万字的长文将分段绘制。"
            android:textColor="?attr/dsColorMuted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 生成中 -->
    <LinearLayout
        android:id="@+id/progressGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/progressIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="正在生成"
            android:src="@drawable/ic_ds_file_text" />

        <TextView
            android:id="@+id/progressTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="正在排版并嵌入字体…"
            android:textColor="?attr/dsColorInk"
            android:textSize="15sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:indicatorColor="?attr/dsColorInk"
            app:trackColor="?attr/dsColorLine"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/progressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0%"
            android:textColor="?attr/dsColorMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 完成 -->
    <LinearLayout
        android:id="@+id/doneGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="导出完成"
            android:src="@drawable/ic_ds_check" />

        <TextView
            android:id="@+id/resultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="?attr/dsColorInk"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/resultDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="?attr/dsColorMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 失败 -->
    <LinearLayout
        android:id="@+id/failGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="导出失败"
            android:src="@drawable/ic_ds_alert" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="没有生成文件"
            android:textColor="?attr/dsColorInk"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/failMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="?attr/dsColorMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondaryButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="?attr/dsColorInk"
            android:textSize="15sp"
            app:cornerRadius="8dp"
            app:strokeColor="?attr/dsColorLineStrong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="开始导出"
            android:textColor="?attr/dsColorBg"
            android:textSize="15sp"
            app:backgroundTint="?attr/dsColorInk"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
